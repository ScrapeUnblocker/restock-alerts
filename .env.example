# Copy to .env for local runs (`cp .env.example .env`). Never commit .env.
# In GitHub Actions set these as repository secrets instead.

# Your ScrapeUnblocker API key: https://scrapeunblocker.com/?utm_source=github&utm_medium=integration&utm_campaign=example-repos
SCRAPEUNBLOCKER_KEY=your_key_here

# Destinations: each one is used when its secrets are set (delivery.destinations in
# config.yml picks which are allowed).

# Telegram: a bot token from @BotFather and the chat id of you, a group or a channel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord: Server Settings > Integrations > Webhooks > New Webhook > Copy Webhook URL.
DISCORD_WEBHOOK_URL=

# Slack: an incoming webhook URL (api.slack.com/messaging/webhooks).
SLACK_WEBHOOK_URL=

# Pushover: your user key, and the API token of an application you create on pushover.net.
PUSHOVER_USER_KEY=
PUSHOVER_APP_TOKEN=

# Any URL that accepts a JSON POST (Zapier, Make, n8n, Home Assistant, your own endpoint).
ALERT_WEBHOOK_URL=

# Only for a self-hosted Telegram Bot API server. Leave empty.
TELEGRAM_API_BASE=
